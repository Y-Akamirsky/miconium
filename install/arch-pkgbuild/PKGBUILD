# Maintainer: Yaroslav Akamirsky <akamirsky.yaros@gmail.com>
pkgname=miconium
pkgver=0.1.0
pkgrel=2
pkgdesc="Material Design 3 SVG icon generator for Linux desktops"
arch=('any')
url="https://github.com/Y-Akamirsky/miconium"
license=('GPL3')
depends=('gtk3' 'gtk-update-icon-cache' 'desktop-file-utils')
makedepends=('cargo' 'git')
optdepends=('matugen')
provides=('miconium')
source=("${pkgname}-${pkgver}::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')
# Post-install/upgrade/remove hooks live in a separate file so that pacman
# shows the iconpack notice also when installing from a binary repository.
# Declared explicitly: makepkg 7.1 does not pick the file up implicitly.
install="miconium.install"

prepare() {
    ln -sf "${pkgname}-${pkgver}" "${pkgname}"
    cd "${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --release --frozen
}

check() {
    cd "${pkgname}"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --release --frozen || true
}

package() {
    cd "${pkgname}"

    # binaries
    install -Dm755 "target/release/miconium-gui"  "${pkgdir}/usr/bin/miconium-gui"
    install -Dm755 "target/release/miconiumd"     "${pkgdir}/usr/bin/miconiumd"

    # appearance stuff
    install -Dm644 "install/miconium.desktop"      "${pkgdir}/usr/share/applications/miconium.desktop"
    install -Dm644 "install/miconium.svg"          "${pkgdir}/usr/share/icons/hicolor/scalable/apps/miconium.svg"

    # daemon (systemd, user)
    install -Dm644 "install/daemon-service/systemd/miconiumd.service" "${pkgdir}/usr/lib/systemd/user/miconiumd.service"

    # reference config, default preset and matugen template (user convenience)
    # NOTE: the icon packs themselves are NOT part of this package — they live in
    # miconium-iconpack and install into /usr/share/miconium/<pack>.
    install -dm755 "${pkgdir}/usr/share/miconium"
    install -Dm644 "install/miconium.example.toml" "${pkgdir}/usr/share/miconium/miconium.example.toml"
    install -Dm644 "install/std-preset.toml"       "${pkgdir}/usr/share/miconium/presets/std-preset.toml"
    install -Dm644 "matugen/template/miconium.json" "${pkgdir}/usr/share/miconium/matugen/template/miconium.json"

    # license
    install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/$pkgname/LICENSE"
}

# NOTE: post_install / post_upgrade / post_remove live in `miconium.install`
# (next to this file) so that pacman also shows the iconpack notice when the
# package is installed from a binary repository. Keeping them here as well
# would run everything twice.
